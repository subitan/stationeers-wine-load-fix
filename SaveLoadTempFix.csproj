<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A BepInEx plugin for Stationeers: when loading a save, a failure to delete the temporary folder
    the save was unpacked into is logged and ignored, rather than failing the whole load. Under
    CrossOver (Wine) on macOS that delete can fail after the world has loaded.

    Builds against the game's DLLs: set STATIONEERS_DIR to the game's install directory.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>SaveLoadTempFix</AssemblyName>
    <RootNamespace>SaveLoadTempFix</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <StationeersDllDir>$(STATIONEERS_DIR)/rocketstation_Data/Managed</StationeersDllDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.2.3" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(StationeersDllDir)/Assembly-CSharp.dll" Private="false" />
  </ItemGroup>

  <PropertyGroup>
    <DistDir>$(MSBuildProjectDirectory)/dist</DistDir>
  </PropertyGroup>

  <!-- The mod's layout, dist/SaveLoadTempFix/{SaveLoadTempFix.dll, About/}: a StationeersLaunchPad mod. -->
  <Target Name="Dist" DependsOnTargets="Build">
    <ItemGroup>
      <AboutFiles Include="About/**/*" />
    </ItemGroup>
    <RemoveDir Directories="$(DistDir)/SaveLoadTempFix" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DistDir)/SaveLoadTempFix" />
    <Copy SourceFiles="@(AboutFiles)" DestinationFolder="$(DistDir)/SaveLoadTempFix/About/%(RecursiveDir)" />
  </Target>

  <Target Name="CheckGameDlls" BeforeTargets="ResolveAssemblyReferences">
    <Error
      Condition="!Exists('$(StationeersDllDir)/Assembly-CSharp.dll')"
      Text="Stationeers' DLLs weren't found in '$(StationeersDllDir)': set STATIONEERS_DIR to the game's install directory." />
  </Target>
</Project>
