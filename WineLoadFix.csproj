<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A BepInEx plugin for Stationeers: when loading a save, a failure to delete the temporary folder
    the save was unpacked into is logged and ignored, rather than failing the whole load. Under
    CrossOver (Wine) on macOS that delete can fail after the world has loaded.

    It needs only NuGet packages: the one game type it patches is found by name when it runs.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>WineLoadFix</AssemblyName>
    <RootNamespace>WineLoadFix</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.2.3" IncludeAssets="compile" />
  </ItemGroup>

  <PropertyGroup>
    <DistDir>$(MSBuildProjectDirectory)/dist</DistDir>
  </PropertyGroup>

  <!-- The mod's layout, dist/WineLoadFix/{WineLoadFix.dll, About/}: a StationeersLaunchPad mod. -->
  <Target Name="Dist" DependsOnTargets="Build">
    <ItemGroup>
      <AboutFiles Include="About/**/*" />
    </ItemGroup>
    <RemoveDir Directories="$(DistDir)/WineLoadFix" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DistDir)/WineLoadFix" />
    <Copy SourceFiles="@(AboutFiles)" DestinationFolder="$(DistDir)/WineLoadFix/About/%(RecursiveDir)" />
  </Target>

</Project>
